# Rebesta Fresh — environment variables
# Copy to .env for local dev; set these in Railway Variables for production.

# --- Core ---
NODE_ENV=production
PORT=3000
APP_URL=https://rebestafresh.in
# Long random string — this is your admin dashboard password
ADMIN_KEY=change-me-to-a-long-random-string
# Path that survives redeploys (Railway volume). Leave empty locally.
# DATA_DIR=/data

# --- PayU (online payments) ---
PAYU_KEY=
PAYU_SALT=
# PAYU_URL=https://secure.payu.in/_payment

# --- Email notifications (order alerts + confirmations) ---
# Gmail: enable 2-step verification, then create an App Password (16 chars):
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=Rebesta Fresh <yourgmail@gmail.com>
# Where YOUR order alerts go (can be same Gmail)
NOTIFY_EMAIL=yourgmail@gmail.com
